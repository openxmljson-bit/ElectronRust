{
  "name": "openxmljson",
  "version": "0.1.0",
  "description": "OPENXMLJSON — a rapid JSON·XML·CSV loading engine, built for gigabytes",
  "main": "main.js",
  "author": "Kiran Peddikuppa",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:engine": "cd rust-engine && cargo build --release",
    "dist": "electron-builder"
  },
  "dependencies": {
    "monaco-editor": "^0.45.0",
    "systeminformation": "^5.22.0"
  },
  "devDependencies": {
    "electron": "^43.1.1"
  },
  "build": {
    "appId": "com.openxmljson.app",
    "productName": "OPENXMLJSON",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "extraResources": [
        {
          "from": "rust-engine/target/release/openjsonxml-engine",
          "to": "engine/openjsonxml-engine"
        }
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "rust-engine/target/release/openjsonxml-engine.exe",
          "to": "engine/openjsonxml-engine.exe"
        }
      ]
    }
  },
  "allowScripts": {
    "electron@43.1.1": true
  }
}
