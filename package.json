{
  "name": "narikjson",
  "version": "0.1.0",
  "description": "NARIKJSON — a rapid JSON·XML·CSV loading engine, built for gigabytes",
  "main": "main.js",
  "author": "Kiran Peddikuppa",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:engine": "cd rust-engine && cargo build --release",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "js-yaml": "^4.3.0",
    "monaco-editor": "^0.45.0",
    "systeminformation": "^5.22.0"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.narikjson.app",
    "productName": "NARIKJSON",
    "directories": {
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "openxmljson-bit",
        "repo": "ElectronRust-Releases"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true,
      "extraResources": [
        {
          "from": "rust-engine/target/release/openjsonxml-engine",
          "to": "engine/openjsonxml-engine"
        }
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "rust-engine/target/release/openjsonxml-engine.exe",
          "to": "engine/openjsonxml-engine.exe"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Development",
      "extraResources": [
        {
          "from": "rust-engine/target/release/openjsonxml-engine",
          "to": "engine/openjsonxml-engine"
        }
      ]
    }
  },
  "allowScripts": {
    "electron@43.1.1": true
  }
}
