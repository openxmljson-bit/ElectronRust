{
  "name": "narikjson",
  "version": "0.1.0",
  "description": "NARIKJSON — a rapid JSON·XML·CSV loading engine, built for gigabytes",
  "main": "main.js",
  "author": "Kiran Peddikuppa",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:engine": "cd rust-engine && cargo build --release",
    "build:duck": "node scripts/build-duck-engine.mjs",
    "build:duck:watch": "node scripts/build-duck-engine.mjs --watch",
    "build:all": "npm run build:engine && npm run build:duck",
    "dist": "npm run build:all && electron-builder",
    "dist:fast": "npm run build:all && electron-builder --config.mac.notarize=false",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.3",
    "electron-updater": "^6.3.9",
    "js-yaml": "^4.3.0",
    "monaco-editor": "^0.45.0",
    "systeminformation": "^5.22.0"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.1"
  },
  "build": {
    "appId": "com.narikjson.app",
    "productName": "NARIKJSON",
    "npmRebuild": false,
    "directories": {
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "openxmljson-bit",
        "repo": "ElectronRust-Releases"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "duck-client.js",
      "renderer/**",
      "dist/engine/**",
      "node_modules/@duckdb/**",
      "!node_modules/monaco-editor/dev/**",
      "!node_modules/monaco-editor/esm/**",
      "!node_modules/monaco-editor/min-maps/**",
      "!node_modules/monaco-editor/monaco.d.ts",
      "!node_modules/monaco-editor/CHANGELOG.md",
      "!node_modules/monaco-editor/ThirdPartyNotices.txt"
    ],
    "asarUnpack": [
      "**/node_modules/@duckdb/**",
      "**/*.node"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true,
      "extraResources": [
        {
          "from": "rust-engine/target/release/openjsonxml-engine",
          "to": "engine/openjsonxml-engine"
        }
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "rust-engine/target/release/openjsonxml-engine.exe",
          "to": "engine/openjsonxml-engine.exe"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Development",
      "extraResources": [
        {
          "from": "rust-engine/target/release/openjsonxml-engine",
          "to": "engine/openjsonxml-engine"
        }
      ]
    }
  },
  "allowScripts": {
    "electron@43.1.1": true
  }
}
